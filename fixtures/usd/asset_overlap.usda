#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    doc = "One defect: arm and box interpenetrate each other by 0.1 on X. Both rest cleanly on the floor."
)

def Xform "World"
{
    def Cube "floor"
    {
        double size = 1.0
        double3 xformOp:translate = (0, 0, 0)
        double3 xformOp:scale = (10, 0.1, 10)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "arm"
    {
        double size = 1.0
        double3 xformOp:translate = (0, 0.55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "box"
    {
        double size = 1.0
        double3 xformOp:translate = (0.9, 0.55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
