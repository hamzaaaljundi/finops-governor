#usda 1.0
(
    defaultPrim = "arm"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "arm"
{
    def Scope "Materials"
    {
        def Material "OrangeMetal"
        {
            token outputs:surface.connect = </arm/Materials/OrangeMetal/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.4, 0.08)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
        def Material "DarkJoint"
        {
            token outputs:surface.connect = </arm/Materials/DarkJoint/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.1)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "Steel"
        {
            token outputs:surface.connect = </arm/Materials/Steel/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.57, 0.6)
                float inputs:metallic = 1.0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Cylinder "base_plate" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "Y"
        double radius = 0.36
        double height = 0.06
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (0, 0.03, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "base" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "Y"
        double radius = 0.26
        double height = 0.18
        rel material:binding = </arm/Materials/Steel>
        double3 xformOp:translate = (0, 0.15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "column" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "Y"
        double radius = 0.11
        double height = 0.48
        rel material:binding = </arm/Materials/OrangeMetal>
        double3 xformOp:translate = (0, 0.48, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "shoulder" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.145
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (0, 0.76, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "upper_arm" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1.0
        rel material:binding = </arm/Materials/OrangeMetal>
        double3 xformOp:translate = (0.26, 1.02, 0)
        float3 xformOp:rotateXYZ = (0, 0, -35)
        float3 xformOp:scale = (0.64, 0.17, 0.17)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cylinder "conduit" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token axis = "X"
        double radius = 0.035
        double height = 0.55
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (0.26, 1.13, 0.1)
        float3 xformOp:rotateXYZ = (0, 0, -35)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "elbow" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.125
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (0.54, 1.22, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "forearm" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1.0
        rel material:binding = </arm/Materials/OrangeMetal>
        double3 xformOp:translate = (0.82, 1.1, 0)
        float3 xformOp:rotateXYZ = (0, 0, 42)
        float3 xformOp:scale = (0.52, 0.14, 0.14)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Sphere "wrist" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.09
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (1.02, 0.93, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "gripper_palm" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1.0
        rel material:binding = </arm/Materials/Steel>
        double3 xformOp:translate = (1.12, 0.87, 0)
        float3 xformOp:rotateXYZ = (0, 0, 20)
        float3 xformOp:scale = (0.1, 0.13, 0.18)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "gripper_finger_l" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1.0
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (1.22, 0.8, 0.055)
        float3 xformOp:rotateXYZ = (0, 0, 20)
        float3 xformOp:scale = (0.14, 0.045, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "gripper_finger_r" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1.0
        rel material:binding = </arm/Materials/DarkJoint>
        double3 xformOp:translate = (1.22, 0.8, -0.055)
        float3 xformOp:rotateXYZ = (0, 0, 20)
        float3 xformOp:scale = (0.14, 0.045, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}
